generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ru
  en
  es
}

enum UserRole {
  owner
  admin
  master
  client
}

enum AppointmentStatus {
  draft
  pending_admin_confirmation
  confirmed
  completed
  canceled
  rescheduled
  no_show
}

enum AttendanceConfirmationStatus {
  not_requested
  pending
  confirmed
  declined
}

enum Currency {
  RUB
  EUR
  USD
}

enum ContactChannel {
  phone
  email
  telegram
  whatsapp
}

enum EmploymentStatus {
  active
  probation
  leave
  dismissed
}

enum EmploymentType {
  owner
  full_time
  part_time
  contractor
  intern
}

enum EmployeeNoteCategory {
  general
  performance
  recognition
  incident
  hr
}

enum TrainingStatus {
  planned
  in_progress
  completed
  canceled
}

enum EmployeeDocumentType {
  employment_contract
  nda
  consent
  medical_book
  certificate
  other
}

enum EmployeeEventType {
  hired
  status_changed
  leave_started
  leave_ended
  dismissed
  rehired
  role_changed
  profile_updated
}

enum BookingSource {
  online
  admin_manual
}

enum PayrollStatus {
  accrued
  partially_paid
  paid
  adjustment_due
}

enum PayrollEntryType {
  master_commission
  admin_commission
  fixed_salary
  review_bonus
  cleaning
  bonus
  deduction
  adjustment
}

model User {
  id           String   @id @default(cuid())
  role         UserRole
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staffProfile StaffProfile?
  client       Client?
  sessions     Session[]
  employeeNotesAuthored  EmployeeNote[]  @relation("EmployeeNoteAuthor")
  employeeEventsAuthored EmployeeEvent[] @relation("EmployeeEventActor")
  appointmentsCreated    Appointment[]   @relation("AppointmentCreator")
  compensationRulesAuthored EmployeeCompensationRule[] @relation("CompensationRuleAuthor")
  payrollsCreated        EmployeePayroll[] @relation("PayrollCreator")
  payrollEntriesAuthored PayrollEntry[] @relation("PayrollEntryAuthor")
  payrollPaymentsAuthored PayrollPayment[] @relation("PayrollPaymentAuthor")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Client {
  id                    String   @id @default(cuid())
  userId                String?  @unique
  fullName              String?
  phone                 String   @unique
  email                 String?
  telegramUsername      String?
  telegramChatId        String?
  whatsappPhone         String?
  allergies             String?
  notes                 String?
  requiresPrepayment    Boolean  @default(false)
  prepaymentReason      String?
  loyaltyStatusId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User?                     @relation(fields: [userId], references: [id])
  loyaltyStatus         ClientLoyaltyStatus?      @relation(fields: [loyaltyStatusId], references: [id])
  appointments          Appointment[]
  privateTagAssignments ClientPrivateTagAssignment[]
  visitNotes            VisitNote[]
  visitMaterials        VisitMaterial[]
  nailPhotos            NailPhoto[]
  consentRecords        ConsentRecord[]

  @@index([telegramUsername])
}

model ClientLoyaltyStatus {
  id          String   @id @default(cuid())
  code        String   @unique
  titleRu     String
  titleEn     String?
  titleEs     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients     Client[]
}

model ClientPrivateTag {
  id          String   @id @default(cuid())
  title       String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments ClientPrivateTagAssignment[]
}

model ClientPrivateTagAssignment {
  id        String   @id @default(cuid())
  clientId  String
  tagId     String
  createdAt DateTime @default(now())

  client    Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag       ClientPrivateTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clientId, tagId])
}

model StaffProfile {
  id                   String           @id @default(cuid())
  userId               String           @unique
  displayName          String
  legalName            String?
  position             String?
  bio                  String?
  employmentStatus     EmploymentStatus @default(active)
  employmentType       EmploymentType   @default(full_time)
  hiredAt              DateTime?
  probationEndsAt      DateTime?
  dismissedAt          DateTime?
  dateOfBirth          DateTime?
  workPhone            String?
  personalEmail        String?
  address              String?
  emergencyContactName String?
  emergencyContactPhone String?
  isBookable           Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user         User                @relation(fields: [userId], references: [id])
  services     StaffService[]
  workingHours WorkingHour[]
  exceptions   ScheduleException[]
  appointments Appointment[]
  employeeNotes EmployeeNote[]
  trainings     EmployeeTraining[]
  documents     EmployeeDocument[]
  employeeEvents EmployeeEvent[]
  compensationRules EmployeeCompensationRule[]
  payrolls       EmployeePayroll[]
}

model EmployeeNote {
  id              String               @id @default(cuid())
  staffId         String
  category        EmployeeNoteCategory @default(general)
  title           String?
  body            String
  eventDate       DateTime?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  staff           StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("EmployeeNoteAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([staffId, createdAt])
}

model EmployeeTraining {
  id             String         @id @default(cuid())
  staffId        String
  title          String
  provider       String?
  status         TrainingStatus @default(planned)
  startsAt       DateTime?
  endsAt         DateTime?
  completedAt    DateTime?
  costMinor      Int?
  currency       Currency?
  certificateUrl String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  staff          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, status])
  @@index([endsAt])
}

model EmployeeDocument {
  id        String               @id @default(cuid())
  staffId   String
  type      EmployeeDocumentType
  title     String
  issuedAt  DateTime?
  expiresAt DateTime?
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, type])
  @@index([expiresAt])
}

model EmployeeEvent {
  id          String            @id @default(cuid())
  staffId     String
  type        EmployeeEventType
  occurredAt  DateTime          @default(now())
  reason      String?
  details     Json?
  actorUserId String?
  createdAt   DateTime          @default(now())

  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  actor       User?        @relation("EmployeeEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([staffId, occurredAt])
}

model EmployeeCompensationRule {
  id                        String   @id @default(cuid())
  staffId                   String
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  masterCommissionBps       Int      @default(0)
  adminBookingCommissionBps Int      @default(0)
  fixedMonthlyMinor         Int      @default(0)
  currency                  Currency @default(RUB)
  createdByUserId           String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  staff                     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy                 User? @relation("CompensationRuleAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([staffId, effectiveFrom])
  @@index([staffId, effectiveFrom, effectiveTo])
}

model EmployeePayroll {
  id                             String        @id @default(cuid())
  staffId                        String
  periodStart                    DateTime
  periodEnd                      DateTime
  currency                       Currency      @default(RUB)
  status                         PayrollStatus @default(accrued)
  masterCommissionBpsSnapshot    Int           @default(0)
  adminCommissionBpsSnapshot     Int           @default(0)
  fixedMonthlyMinorSnapshot      Int           @default(0)
  appointmentCommissionMinor     Int           @default(0)
  fixedMinor                     Int           @default(0)
  adjustmentsMinor               Int           @default(0)
  totalAccruedMinor              Int           @default(0)
  totalPaidMinor                 Int           @default(0)
  accruedAt                      DateTime       @default(now())
  paidAt                         DateTime?
  createdByUserId                String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  staff                          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy                      User? @relation("PayrollCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  entries                        PayrollEntry[]
  payments                       PayrollPayment[]

  @@unique([staffId, periodStart, currency])
  @@index([periodStart, status])
}

model PayrollEntry {
  id                String           @id @default(cuid())
  payrollId         String
  appointmentId     String?
  type              PayrollEntryType
  description       String
  sourceAmountMinor Int?
  rateBps           Int?
  amountMinor       Int
  occurredAt        DateTime
  createdByUserId   String?
  createdAt         DateTime         @default(now())

  payroll           EmployeePayroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy         User? @relation("PayrollEntryAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([payrollId, appointmentId, type])
  @@index([payrollId, type])
}

model PayrollPayment {
  id              String   @id @default(cuid())
  payrollId       String
  amountMinor     Int
  paidAt          DateTime
  method          String?
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  payroll         EmployeePayroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  createdBy       User? @relation("PayrollPaymentAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([payrollId, paidAt])
}

model Service {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  titleRu                String
  titleEn                String?
  titleEs                String?
  category               String?
  durationMinutes        Int
  isActive               Boolean  @default(true)
  requiresManualReview   Boolean  @default(false)
  bufferAfterMinutes     Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  staffServices          StaffService[]
  appointments           Appointment[]
  prices                 ServicePrice[]
}

model ServicePrice {
  id          String   @id @default(cuid())
  serviceId   String
  currency    Currency
  amountMinor Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, currency])
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String
  serviceId String

  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
}

model WorkingHour {
  id          String @id @default(cuid())
  staffId     String
  weekday     Int
  startsAt    String
  endsAt      String
  isActive    Boolean @default(true)

  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, weekday])
}

model ScheduleException {
  id          String   @id @default(cuid())
  staffId     String
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  isBookable  Boolean  @default(false)
  createdAt   DateTime @default(now())

  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
}

model Appointment {
  id               String            @id @default(cuid())
  clientId         String
  staffId          String
  serviceId        String
  status           AppointmentStatus @default(pending_admin_confirmation)
  attendanceConfirmationStatus AttendanceConfirmationStatus @default(not_requested)
  startsAt         DateTime
  endsAt           DateTime
  clientComment    String?
  internalNote     String?
  clientConfirmedAt DateTime?
  attendanceConfirmationRequestedAt DateTime?
  adminConfirmedAt  DateTime?
  canceledAt       DateTime?
  cancellationReason String?
  source           BookingSource     @default(online)
  createdByUserId   String?
  priceMinor        Int               @default(0)
  currency          Currency          @default(RUB)
  completedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  client           Client       @relation(fields: [clientId], references: [id])
  staff            StaffProfile @relation(fields: [staffId], references: [id])
  service          Service      @relation(fields: [serviceId], references: [id])
  createdBy        User?        @relation("AppointmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  events           AppointmentEvent[]
  visitNotes       VisitNote[]
  visitMaterials   VisitMaterial[]
  nailPhotos       NailPhoto[]
  payrollEntries   PayrollEntry[]

  @@index([staffId, startsAt, endsAt])
  @@index([clientId, startsAt])
  @@index([status])
  @@index([createdByUserId, source, completedAt])
  @@index([completedAt, status])
}

model AppointmentEvent {
  id            String            @id @default(cuid())
  appointmentId String
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  actorUserId   String?
  note          String?
  createdAt     DateTime          @default(now())

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model VisitNote {
  id            String   @id @default(cuid())
  clientId      String
  appointmentId String?
  authorUserId  String?
  note          String
  createdAt     DateTime @default(now())

  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model VisitMaterial {
  id            String   @id @default(cuid())
  clientId      String
  appointmentId String?
  name          String
  colorCode     String?
  brand         String?
  notes         String?
  createdAt     DateTime @default(now())

  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model NailPhoto {
  id            String   @id @default(cuid())
  clientId      String
  appointmentId String?
  url           String
  caption       String?
  createdAt     DateTime @default(now())

  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  code      String   @unique
  channel   String
  locale    Locale   @default(ru)
  title     String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationJob {
  id          String   @id @default(cuid())
  channel     String
  recipient   String
  templateCode String?
  payload     Json?
  scheduledAt DateTime
  sentAt      DateTime?
  failedAt    DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([scheduledAt, sentAt])
}

model Payment {
  id            String   @id @default(cuid())
  appointmentId String?
  clientId      String?
  amount        Int
  currency      Currency @default(RUB)
  status        String
  provider      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id            String   @id @default(cuid())
  appointmentId String?
  clientId      String?
  rating        Int
  text          String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model ConsentRecord {
  id          String   @id @default(cuid())
  clientId    String
  type        String
  grantedAt   DateTime?
  revokedAt   DateTime?
  source      String?
  createdAt   DateTime @default(now())

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, type])
}
