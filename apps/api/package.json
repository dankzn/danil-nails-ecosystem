{
  "name": "@danil-nails/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "pnpm --filter @danil-nails/db build && pnpm --filter @danil-nails/shared build",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "start": "node dist/index.js",
    "lint": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@danil-nails/db": "workspace:*",
    "@danil-nails/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "dotenv": "^18.0.1",
    "fastify": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "latest",
    "typescript": "^7.0.2"
  }
}
